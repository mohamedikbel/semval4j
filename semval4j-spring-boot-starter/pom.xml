<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mohamedikbel</groupId>
    <artifactId>semval4j-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>semval4j-spring-boot-starter</artifactId>
  <name>SemVal4j Spring Boot Starter</name>
  <description>Spring Boot auto-configuration for SemVal4j semantic validation.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mohamedikbel</groupId>
      <artifactId>semval4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mohamedikbel</groupId>
      <artifactId>semval4j-jakarta</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mohamedikbel</groupId>
      <artifactId>semval4j-langchain4j</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.mohamedikbel</groupId>
      <artifactId>semval4j-typesafe</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>io.github.mohamedikbel</groupId>
      <artifactId>semval4j-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
